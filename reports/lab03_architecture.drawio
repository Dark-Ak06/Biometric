<mxfile host="app.diagrams.net" modified="2026-10-16T11:45:00.000Z" agent="Antigravity" version="24.0.0" type="device">
  <diagram id="biometric_access_control" name="Архитектура биометрической СКУД (Enrollment &amp; Verification)">
    <mxGraphModel dx="1422" dy="798" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Заголовок Enrollment -->
        <mxCell id="title_enr" value="КОНТУР РЕГИСТРАЦИИ (ENROLLMENT PIPELINE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="1380" height="40" as="geometry" />
        </mxCell>

        <!-- Блоки Enrollment -->
        <mxCell id="enr_sensor" value="1. Сенсор захвата&#xa;(RGB + NIR камера,&#xa;ИК-подсветка)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="enr_prep" value="2. Предобработка и QA&#xa;(Детекция лица, оценка&#xa;качества, выравнивание)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="110" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="enr_feat" value="3. Извлечение признаков&#xa;(Feature Extractor:&#xa;CNN ArcFace → вектор 512 float)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="110" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="enr_tmpl" value="4. Генератор шаблона&#xa;(Квантование, Cancelable&#xa;Biometrics, шифрование AES-256)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="110" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="db" value="5. Хранилище шаблонов&#xa;(Template Database&#xa;PostgreSQL + HSM:&#xa;Subject_ID, Encrypted_Template)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1240" y="210" width="200" height="120" as="geometry" />
        </mxCell>

        <!-- Стрелки Enrollment -->
        <mxCell id="e1" value="Сырой кадр" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="enr_sensor" target="enr_prep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="Нормализованный ROI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="enr_prep" target="enr_feat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Вектор признаков" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="enr_feat" target="enr_tmpl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="Запись (ID + Шаблон)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="enr_tmpl" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Заголовок Verification -->
        <mxCell id="title_ver" value="КОНТУР ВЕРИФИКАЦИИ 1:1 (VERIFICATION PIPELINE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="1380" height="40" as="geometry" />
        </mxCell>

        <!-- Блоки Verification -->
        <mxCell id="ver_rfid" value="Считыватель смарт-карт&#xa;(RFID Mifare DESFire:&#xa;заявленный Subject_ID)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ver_sensor" value="1. Сенсор захвата&#xa;(RGB + NIR камера +&#xa;Liveness / PAD детектор)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ver_prep" value="2. Предобработка&#xa;(Проверка живости PAD,&#xa;выравнивание лица)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="540" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ver_feat" value="3. Извлечение признаков&#xa;(Feature Extractor:&#xa;CNN ArcFace → вектор V_live)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="540" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ver_match" value="6. Модуль сравнения (Matcher)&#xa;Косинусное сходство:&#xa;S = cos(V_live, V_db)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="540" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ver_dec" value="7. Модуль принятия решения&#xa;(Decision Module)&#xa;Проверка порога: S &gt;= T ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="680" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ver_act_ok" value="8a. Исполнительное устройство&#xa;(ACCEPT: Открытие электромагнитного&#xa;замка двери + запись в журнал)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1250" y="650" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="ver_act_no" value="8b. Отказ в доступе&#xa;(REJECT: Блокировка замка +&#xa;уведомление охраны при 3 отказах)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1250" y="750" width="230" height="75" as="geometry" />
        </mxCell>

        <!-- Стрелки Verification -->
        <mxCell id="v1" value="Кадр + ИК-карта" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="ver_sensor" target="ver_prep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Liveness=OK, ROI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="ver_prep" target="ver_feat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="Вектор V_live" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="ver_feat" target="ver_match">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="Запрос шаблона по Subject_ID" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="ver_rfid" target="db">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="160" y="420" />
              <mxPoint x="1190" y="420" />
              <mxPoint x="1190" y="270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="v5" value="Эталонный шаблон V_db (TLS 1.3)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="db" target="ver_match">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v6" value="Оценка сходства S" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="ver_match" target="ver_dec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="Да (S &gt;= T)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#009900;" edge="1" parent="1" source="ver_dec" target="ver_act_ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="Нет (S &lt; T)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#CC0000;" edge="1" parent="1" source="ver_dec" target="ver_act_no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Угрозы (Threat Modeling) -->
        <mxCell id="t1" value="⚠️ Угроза 1: Spoofing&#xa;(фото/видео/3D-маска)&#xa;Защита: NIR + Liveness" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffcd28;strokeColor=#d79b00;size=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="⚠️ Угроза 2: Replay-атака&#xa;в канале Сенсор→Препроцессор&#xa;Защита: Mutual TLS + Nonce" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffcd28;strokeColor=#d79b00;size=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="650" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="⚠️ Угроза 3: Подмена признаков&#xa;(Trojan Feature Extractor)&#xa;Защита: Подпись кода, TEE/SGX" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffcd28;strokeColor=#d79b00;size=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="650" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="⚠️ Угроза 4: Утечка/подмена БД&#xa;Защита: Cancelable Biometrics,&#xa;AES-256-GCM в HSM" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffcd28;strokeColor=#d79b00;size=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1240" y="70" width="210" height="80" as="geometry" />
        </mxCell>
